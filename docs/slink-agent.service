# slink-agent.service — SOLID VM Agent 자동 실행 (systemd)
#
# 설치 방법:
#   1. 아래 SOLID_INSTANCE_ID 를 실제 인스턴스 ID 로 변경 (예: solid-32211690)
#   2. User= 을 실제 VM 사용자 이름으로 변경 (기본값: ubuntu)
#   3. 파일을 VM에 복사:
#        sudo cp slink-agent.service /etc/systemd/system/slink-agent.service
#   4. 서비스 등록 및 시작:
#        sudo systemctl daemon-reload
#        sudo systemctl enable slink-agent
#        sudo systemctl start slink-agent
#
# 상태 확인:  sudo systemctl status slink-agent
# 실시간 로그: sudo journalctl -u slink-agent -f
# 중지:       sudo systemctl stop slink-agent
#
# 주의:
#   - slink init 으로 ~/.slinkrc 가 먼저 생성되어 있어야 한다.
#   - cloudflared 가 PATH에 없으면 heartbeat는 동작하지만 터널을 열 수 없다.
#   - Agent가 재시작되면 새 agentId가 발급되므로 PENDING 서비스는 다시 publish 필요.

[Unit]
Description=SOLID VM Agent (slink)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/.local/bin/slink agent start --instance-id SOLID_INSTANCE_ID
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
